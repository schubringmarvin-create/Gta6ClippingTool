# Kopieren nach .env (nur auf dem Server, nie ins Git!) und ausfüllen.

# Adresse der App mit HTTPS. Ohne eigene Domain: IP mit Bindestrichen + .sslip.io
# Beispiel bei IP 49.12.34.56:  DOMAIN=49-12-34-56.sslip.io
DOMAIN=

# Passwort für die Handy-App (lang und zufällig wählen)
APP_PASSWORD=

# Twitch-Entwickler-App (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: Claude schreibt Hook + Caption (sonst einfache Vorlage)
ANTHROPIC_API_KEY=

# Optional: eingebrannte Untertitel (braucht ca. 1–2 GB RAM mehr). 0 = aus
ENABLE_CAPTIONS=0
WHISPER_MODEL=small

# Feineinstellung Hype-Erkennung
# Chat muss x-mal schneller sein als normal
HYPE_FACTOR=3.0
# mindestens so viele Nachrichten pro Sekunde
HYPE_MIN_RATE=1.0
# Sekunden Pause nach einem Treffer
HYPE_COOLDOWN=120
# Sekunden vor dem Hype-Moment
CLIP_BEFORE=35
# Sekunden danach
CLIP_AFTER=10
# warten, bis die Stelle im Twitch-VOD liegt
VOD_DELAY=90
# alle x Sekunden prüfen, wer live ist
POLL_INTERVAL=60
